{
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "sort-by-number": true,
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },
  "hyprland/window": {
    "format": " {title}",
    "max-length": 50,
    "rewrite": {
      "": "Desktop"
    }
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "tooltip-format": "CPU Usage\n\nCurrent: {usage}%",
    "on-click": "kitty -e htop"
  },
  "memory": {
    "interval": 10,
    "format": " {percentage}%",
    "tooltip-format": "Memory: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
    "on-click": "kitty -e htop"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "tooltip-format": "Temperature: {temperatureC}°C",
    "on-click": "kitty -e watch sensors"
  },
  "disk": {
    "interval": 30,
    "format": " {percentage_used}%",
    "path": "/",
    "tooltip-format": "Disk: {percentage_used}%\nFree: {free}",
    "on-click": "kitty -e ncdu /"
  },
  "network": {
    "interval": 5,
    "format-wifi": "  {essid}",
    "max-length": 10,
    "format-ethernet": " {ipaddr}",
    "format-disconnected": " Disconnected",
    "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\n {bandwidthUpBits} |  {bandwidthDownBits}",
    "tooltip-format-ethernet": "Ethernet: {ipaddr}\n {bandwidthUpBits} |  {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "kitty -e bluetui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "scroll-step": 5,
    "tooltip-format": "Volume: {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "max-volume": 100,
    "format-icons": {
      "default": [
        "",
        ""
      ]
    }
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
    "scroll-step": 5
  },
  "battery": {
    "interval": 5,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo} remaining",
    "on-click": "kitty -e upower -i /org/freedesktop/UPower/devices/battery_BAT0"
  },
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/lock",
      "custom/suspend",
      "custom/logout",
      "custom/reboot",
      "custom/quit"
    ]
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false
  },
  "custom/lock": {
    "format": "󰌾",
    "tooltip": true,
    "on-click": "hyprlock",
    "return-type": "json",
    "exec": "echo '{\"tooltip\": \"Lock Screen\"}'",
    "interval": 86400
  },
  "custom/suspend": {
    "format": "󰤄",
    "tooltip": true,
    "on-click": "systemctl suspend",
    "return-type": "json",
    "exec": "echo '{\"tooltip\": \"Suspend System\"}'",
    "interval": 86400
  },
  "custom/logout": {
    "format": "󰍃",
    "tooltip": true,
    "on-click": "hyprctl dispatch exit",
    "return-type": "json",
    "exec": "echo '{\"tooltip\": \"Logout Session\"}'",
    "interval": 86400
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip": true,
    "on-click": "systemctl reboot",
    "return-type": "json",
    "exec": "echo '{\"tooltip\": \"Reboot System\"}'",
    "interval": 86400
  },
  "custom/quit": {
    "format": "󰐥",
    "tooltip": true,
    "on-click": "systemctl poweroff",
    "return-type": "json",
    "exec": "echo '{\"tooltip\": \"Shutdown System\"}'",
    "interval": 86400
  }
}
